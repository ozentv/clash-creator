# Clé créée sur https://developer.clashofclans.com (My Account > Create New Key).
# La clé est liée à l'adresse IP publique de la machine qui fait tourner le serveur.
COC_API_TOKEN=
# Facultatif : adresse d'un proxy à IP fixe (ex. https://cocproxy.royaleapi.dev/v1) si l'hébergeur
# n'a pas d'IP sortante unique. Le token transite alors par ce proxy.
COC_API_BASE_URL=

# Facultatif : clé API Claude (https://platform.claude.com) pour générer le texte TikTok par IA.
# Sans elle, le texte est produit par des modèles de phrases locaux. Chaque génération IA est facturée.
ANTHROPIC_API_KEY=
# Nombre maximal de générations IA par heure, tous visiteurs confondus (20 par défaut).
AI_HOURLY_LIMIT=

PORT=3001
