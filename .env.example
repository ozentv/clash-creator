# Clé créée sur https://developer.clashofclans.com (My Account > Create New Key).
# La clé est liée à l'adresse IP publique de la machine qui fait tourner le serveur.
COC_API_TOKEN=
# Facultatif : adresse d'un proxy à IP fixe (ex. https://cocproxy.royaleapi.dev/v1) si l'hébergeur
# n'a pas d'IP sortante unique. Le token transite alors par ce proxy.
COC_API_BASE_URL=

# Facultatif : ajout de compositions et de bases depuis le site (bouton « Gérer »).
# DATABASE_URL : adresse de connexion d'une base PostgreSQL (Neon, Supabase, Render…).
# ADMIN_PASSWORD : mot de passe du mode gestion, 8 caractères minimum.
DATABASE_URL=
ADMIN_PASSWORD=

# Nombre maximal de requêtes API par minute et par visiteur (120 par défaut).
RATE_LIMIT_PER_MINUTE=

PORT=3001
