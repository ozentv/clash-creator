# Clé créée sur https://developer.clashofclans.com (My Account > Create New Key).
# La clé est liée à l'adresse IP publique de la machine qui fait tourner le serveur.
COC_API_TOKEN=
# Facultatif : adresse d'un proxy à IP fixe (ex. https://cocproxy.royaleapi.dev/v1) si l'hébergeur
# n'a pas d'IP sortante unique. Le token transite alors par ce proxy.
COC_API_BASE_URL=

PORT=3001
